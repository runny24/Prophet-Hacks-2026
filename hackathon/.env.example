# Prophet Arena
PA_SERVER_URL=https://api.aiprophet.dev
PA_SERVER_API_KEY=

# Trading bot runtime
EDGE_TRADER_SLUG=rag-blf-edge-trader-v01
EDGE_TRADER_MODEL=custom:rag-blf-edge-trader
EDGE_TRADER_DRY_RUN=1
EDGE_TRADER_ENABLE_RAG=0
EDGE_TRADER_MAX_RAG_MARKETS_PER_TICK=3

# Search
BRAVE_SEARCH_API_KEY=

# LLM provider
EDGE_TRADER_LLM_PROVIDER=openrouter

# OpenRouter API key
OPENROUTER_API_KEY=

# Default local/test model through OpenRouter
EDGE_TRADER_LLM_MODEL=deepseek/deepseek-chat

# Optional stronger DeepSeek model if supported by OpenRouter/account.
# EDGE_TRADER_LLM_MODEL=deepseek/deepseek-r1

# LLM feature flags
EDGE_TRADER_ENABLE_LLM_RAG=0
EDGE_TRADER_ENABLE_BLF=0

# LLM runtime controls
EDGE_TRADER_LLM_TIMEOUT_SECONDS=20
EDGE_TRADER_LLM_JSON_RETRIES=1
EDGE_TRADER_MAX_LLM_EVIDENCE_ITEMS=5
